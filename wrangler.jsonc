{
	"$schema": "https://unpkg.com/wrangler@4.159.0/config-schema.json",
	"name": "neotraverse-docs",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "docs/.vitepress/dist",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "neotraverse.puruvj.dev", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true
}
