{
	"$schema": "https://unpkg.com/wrangler@4.159.0/config-schema.json",
	"name": "neotraverse-docs",
	"main": "docs/.svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "docs/.svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "neotraverse.puruvj.dev", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true }
}
