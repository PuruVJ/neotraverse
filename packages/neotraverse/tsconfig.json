{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		// Do not reenable this, breaks types for pre-4.5 TS
		// "verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"types": ["node", "vite-plus/test/importMeta"],
		// Loose, ported legacy tests + the throwaway bench script use untyped `this`
		// and callback params; the library source (checked strictly in CI via
		// tsconfig.build.json) does not rely on these.
		"noImplicitAny": false,
		"noImplicitThis": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "test", "bench"]
}
