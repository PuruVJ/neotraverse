{
	"name": "neotraverse",
	"version": "0.7.0",
	"description": "traverse and transform objects by visiting every node on a recursive walk",
	"main": "dist/legacy/legacy.cjs",
	"type": "module",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"legacy.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": {
				"production": "./dist/min/index.js",
				"development": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"default": "./dist/min/index.js"
		},
		"./modern": {
			"types": "./dist/modern/modern.d.ts",
			"import": {
				"production": "./dist/modern/min/modern.js",
				"development": "./dist/modern/modern.js",
				"default": "./dist/modern/modern.js"
			},
			"default": "./dist/modern/modern.js"
		},
		"./legacy": {
			"require": {
				"types": "./dist/legacy/legacy.d.cts",
				"default": "./dist/legacy/legacy.cjs"
			},
			"import": {
				"types": "./dist/legacy/legacy.d.ts",
				"default": "./dist/legacy/legacy.mjs"
			},
			"default": "./dist/legacy/legacy.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"compile": "tsdown && cp dist/legacy/legacy.cjs legacy.js && cp dist/legacy/legacy.d.cts legacy.d.ts",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"bench": "pnpm compile && node --expose-gc --max-semi-space-size=128 --import tsx bench/run.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PuruVJ/neotraverse.git",
		"directory": "packages/neotraverse"
	},
	"homepage": "https://neotraverse.puruvj.dev",
	"keywords": [
		"traverse",
		"walk",
		"recursive",
		"map",
		"forEach",
		"deep",
		"clone"
	],
	"author": {
		"name": "Puru Vijay, James Halliday"
	},
	"publishConfig": {
		"provenance": true
	},
	"license": "MIT",
	"engines": {
		"node": ">= 10"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@vitest/coverage-v8": "^4.1.8",
		"tinybench": "^6.0.2",
		"traverse": "^0.6.11",
		"tsdown": "^0.22.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
