{
	"name": "neotraverse-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter neotraverse compile",
		"test": "pnpm --filter neotraverse test",
		"test:cov": "pnpm --filter neotraverse test:cov",
		"bench": "pnpm --filter neotraverse bench",
		"docs:dev": "pnpm --filter docs dev",
		"docs:build": "pnpm --filter docs build",
		"docs:preview": "pnpm --filter docs preview",
		"changeset": "changeset",
		"ci:version": "changeset version",
		"ci:release": "pnpm --filter neotraverse compile && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0"
	},
	"engines": {
		"node": ">= 20"
	},
	"packageManager": "pnpm@10.32.0"
}
